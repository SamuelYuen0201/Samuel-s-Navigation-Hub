    // ==========================================
    // 瀏覽器多維特徵檢測 (BrowserCheck Standard)
    // ==========================================
    function getCanvasHash() {
      try {
        const c = document.createElement('canvas');
        c.width = 200; c.height = 50;
        const ctxt = c.getContext('2d');
        ctxt.textBaseline = "top"; ctxt.font = "14px 'Arial'";
        ctxt.fillStyle = "#f60"; ctxt.fillRect(125, 1, 62, 20);
        ctxt.fillStyle = "#069"; ctxt.fillText("Samuel,Hub:Fingerprint", 2, 15);
        const dataURI = c.toDataURL();
        let hash = 0;
        for (let i = 0; i < dataURI.length; i++) {
          hash = (hash << 5) - hash + dataURI.charCodeAt(i);
          hash |= 0;
        }
        return 'cv_' + Math.abs(hash).toString(16);
      } catch (e) {
        return 'N/A';
      }
    }

    async function getAudioHash() {
      try {
        const AudioContext = window.OfflineAudioContext || window.webkitAudioContext;
        if (!AudioContext) return 'No AudioContext';
        const context = new AudioContext(1, 44100, 44100);
        const osc = context.createOscillator();
        osc.type = 'triangle'; osc.frequency.value = 10000;
        const comp = context.createDynamicsCompressor();
        osc.connect(comp); comp.connect(context.destination);
        osc.start(0);
        const rendered = await context.startRendering();
        const output = rendered.getChannelData(0);
        let hash = 0;
        for (let i = 0; i < 500; i++) hash += Math.abs(output[i]);
        return 'au_' + hash.toFixed(4);
      } catch (e) {
        return 'Shielded';
      }
    }

    function getWebRtcIp() {
      return new Promise((resolve) => {
        try {
          const rtc = new (window.RTCPeerConnection || window.webkitRTCPeerConnection)({
            iceServers: [{ urls: 'stun:stun.l.google.com:19302' }]
          });
          rtc.createDataChannel('');
          rtc.createOffer().then(o => rtc.setLocalDescription(o)).catch(() => resolve('Blocked'));
          rtc.onicecandidate = (e) => {
            if (!e || !e.candidate) { resolve('None Detected'); return; }
            const match = e.candidate.candidate.match(/([0-9]{1,3}(\.[0-9]{1,3}){3})/);
            if (match) { rtc.close(); resolve(match[1]); }
          };
          setTimeout(() => resolve('Timeout / Protected'), 1500);
        } catch (e) {
          resolve('Disabled');
        }
      });
    }

    function getWebGlInfo() {
      try {
        const gl = document.createElement('canvas').getContext('webgl');
        if (!gl) return { vendor: 'N/A', renderer: 'N/A' };
        const ext = gl.getExtension('WEBGL_debug_renderer_info');
        return {
          vendor: ext ? gl.getParameter(ext.UNMASKED_VENDOR_WEBGL) : 'Generic',
          renderer: ext ? gl.getParameter(ext.UNMASKED_RENDERER_WEBGL) : 'Generic'
        };
      } catch (e) {
        return { vendor: 'N/A', renderer: 'N/A' };
      }
    }

