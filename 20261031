<!DOCTYPE html>
<html lang="zh-HK" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portal &bull; Samuel Yuen</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com">
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            serif: ['Newsreader', 'Georgia', 'serif'],
            sans: ['"Plus Jakarta Sans"', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
          },
          colors: {
            claude: {
              cream: '#FAF7F2',
              card: '#FFFFFF',
              border: '#E8E4DC',
              borderHover: '#D4CEBF',
              text: '#22201D',
              muted: '#7A756D',
              terracotta: '#D97757',
              terracottaHover: '#C26343',
              darkBg: '#141311',
              darkCard: '#1C1A17',
              darkBorder: '#2E2B25',
              darkText: '#EDEBE8',
              darkMuted: '#969188'
            }
          }
        }
      }
    }
  </script>

  <style>
    /* 背景邊緣漸層柔化遮罩，令點陣與等高線自然融入背景 */
    #liveFluidCanvas {
      mask-image: radial-gradient(ellipse 92% 88% at 50% 50%, rgba(0, 0, 0, 1) 45%, rgba(0, 0, 0, 0.25) 100%);
      -webkit-mask-image: radial-gradient(ellipse 92% 88% at 50% 50%, rgba(0, 0, 0, 1) 45%, rgba(0, 0, 0, 0.25) 100%);
    }

    /* 液態玻璃核心樣式 (Liquid Glass Card) */
    .liquid-glass {
      background: rgba(255, 255, 255, 0.65);
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      border: 1px solid rgba(255, 255, 255, 0.75);
      box-shadow: 
        0 6px 20px -3px rgba(35, 28, 20, 0.04),
        0 2px 6px -1px rgba(35, 28, 20, 0.02),
        inset 0 1px 1px 0 rgba(255, 255, 255, 0.9);
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
      overflow: hidden;
    }
    .dark .liquid-glass {
      background: rgba(28, 26, 23, 0.68);
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 
        0 8px 24px -4px rgba(0, 0, 0, 0.45),
        inset 0 1px 1px 0 rgba(255, 255, 255, 0.06);
    }
    .liquid-glass:hover {
      transform: translateY(-4px) scale(1.012);
      border-color: rgba(217, 119, 87, 0.45);
      box-shadow: 
        0 16px 32px -6px rgba(217, 119, 87, 0.12),
        0 6px 12px -2px rgba(35, 28, 20, 0.04),
        inset 0 1px 2px 0 rgba(255, 255, 255, 0.95);
    }
    .dark .liquid-glass:hover {
      border-color: rgba(217, 119, 87, 0.5);
      box-shadow: 
        0 16px 36px -6px rgba(0, 0, 0, 0.6),
        0 0 20px 0 rgba(217, 119, 87, 0.12),
        inset 0 1px 1.5px 0 rgba(255, 255, 255, 0.12);
    }

    /* 液態鏡面微光折射效果 */
    .liquid-glass::before {
      content: '';
      position: absolute;
      top: 0;
      left: -120%;
      width: 70%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.28), transparent);
      transform: skewX(-20deg);
      transition: left 0.75s ease;
      pointer-events: none;
    }
    .liquid-glass:hover::before {
      left: 140%;
    }

    /* 畫廊容器不作懸浮放大，保持穩定觀賞 */
    .gallery-glass {
      background: rgba(255, 255, 255, 0.65);
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      border: 1px solid rgba(255, 255, 255, 0.75);
      box-shadow: 0 10px 30px -5px rgba(35, 28, 20, 0.06);
    }
    .dark .gallery-glass {
      background: rgba(28, 26, 23, 0.72);
      border: 1px solid rgba(255, 255, 255, 0.09);
      box-shadow: 0 12px 36px -6px rgba(0, 0, 0, 0.55);
    }

    /* 卡片進場動畫 */
    @keyframes cardFadeIn {
      from { opacity: 0; transform: translateY(14px) scale(0.98); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .animate-card {
      animation: cardFadeIn 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    /* 電影感相片緩慢縮放 (Ken Burns Effect) */
    @keyframes kenBurns {
      0% { transform: scale(1) translate(0, 0); }
      50% { transform: scale(1.06) translate(-0.8%, -0.5%); }
      100% { transform: scale(1) translate(0, 0); }
    }
    .animate-kenburns {
      animation: kenBurns 18s ease-in-out infinite;
    }

    /* 層疊卡片遊戲動態樣式 */
    .game-card-covered {
      filter: brightness(0.68) grayscale(0.25);
      pointer-events: none;
      opacity: 0.75;
      box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }
    .game-card-active {
      filter: brightness(1);
      cursor: pointer;
      opacity: 1;
      box-shadow: 0 6px 14px -2px rgba(0,0,0,0.12), 0 2px 4px rgba(0,0,0,0.06);
    }
    .game-card-active:hover {
      transform: translateY(-3px) scale(1.03);
    }
  </style>
</head>

<body class="bg-claude-cream dark:bg-claude-darkBg text-claude-text dark:text-claude-darkText min-h-screen font-sans flex flex-col antialiased selection:bg-[#F3D7CD] selection:text-[#96371B] relative overflow-x-hidden">

  <!-- 方案三 + 方案四融合：演算法等高線波紋與互動磁場向量點陣 Canvas 背景 -->
  <canvas id="liveFluidCanvas" class="fixed inset-0 pointer-events-none z-0 w-full h-full"></canvas>

  <!-- 頂部導航列 / Top Header -->
  <header class="relative z-10 w-full max-w-5xl mx-auto px-6 py-7 flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl bg-claude-terracotta text-white flex items-center justify-center shadow-md shadow-claude-terracotta/20">
        <i data-lucide="compass" class="w-5 h-5"></i>
      </div>
      <div>
        <h1 class="font-serif text-2xl tracking-tight text-claude-text dark:text-claude-darkText font-medium">Samuel's Hub</h1>
        <p class="text-xs text-claude-muted dark:text-claude-darkMuted font-sans">Workspace &bull; yph.app</p>
      </div>
    </div>

    <!-- 頂部狀態列：DSE 倒數 + GPS 天氣 (可點擊) + 時鐘 + 工具按鈕 -->
    <div class="flex items-center flex-wrap gap-2 sm:gap-2.5">
      
      <!-- DSE 中文卷一即時倒數膠囊 (2027年4月8日開考) -->
      <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-claude-terracotta/35 dark:border-claude-terracotta/40 bg-claude-terracotta/10 text-claude-terracotta text-xs font-medium shadow-sm backdrop-blur-md" title="2027 DSE 中國語文（卷一／卷二）開考時間：2027-04-08 08:30">
        <i data-lucide="sparkles" class="w-3.5 h-3.5 text-claude-terracotta animate-pulse"></i>
        <span id="dseCountdownText">DSE 卷一 · 載入中...</span>
      </div>

      <!-- 基於 GPS 定位的實時天氣膠囊 (點擊彈出詳細氣象儀表板) -->
      <button onclick="toggleWeatherModal()" id="weatherBadge" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-white/60 dark:border-claude-darkBorder bg-white/70 dark:bg-claude-darkCard/70 hover:border-claude-terracotta dark:hover:border-claude-terracotta text-xs text-claude-muted dark:text-claude-darkMuted backdrop-blur-md shadow-sm transition-all cursor-pointer group" title="點擊檢視詳細氣象指標">
        <span id="weatherIconContainer"><i data-lucide="cloud-sun" class="w-3.5 h-3.5 text-amber-500"></i></span>
        <span id="weatherTemp" class="font-mono font-medium text-claude-text dark:text-claude-darkText">--°C</span>
        <span id="weatherCondition" class="hidden sm:inline text-[11px]">定位中...</span>
        <i data-lucide="info" class="w-3 h-3 text-claude-muted/60 group-hover:text-claude-terracotta transition-colors ml-0.5"></i>
      </button>

      <!-- 實時時間 -->
      <div id="statusBadge" class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-full border border-white/60 dark:border-claude-darkBorder bg-white/70 dark:bg-claude-darkCard/70 text-xs text-claude-muted dark:text-claude-darkMuted backdrop-blur-md shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span id="liveClock">00:00</span>
      </div>

      <!-- 層疊卡片遊戲按鈕 -->
      <button onclick="openGameModal()" class="px-3 py-1.5 rounded-xl border border-white/70 dark:border-claude-darkBorder hover:border-claude-terracotta bg-white/80 dark:bg-claude-darkCard/80 hover:text-claude-terracotta transition-all text-xs font-medium flex items-center gap-1.5 shadow-sm backdrop-blur-md" title="層疊卡片遊戲">
        <i data-lucide="layers" class="w-4 h-4 text-claude-terracotta"></i>
        <span class="hidden sm:inline">層疊卡片</span>
      </button>

      <!-- 隨手便簽 -->
      <button onclick="toggleScratchpad()" class="p-2.5 rounded-xl border border-white/70 dark:border-claude-darkBorder hover:border-claude-terracotta bg-white/80 dark:bg-claude-darkCard/80 hover:text-claude-terracotta transition-all text-sm flex items-center gap-1.5 shadow-sm backdrop-blur-md" title="輕量便簽 · Scratchpad">
        <i data-lucide="notebook-pen" class="w-4 h-4"></i>
      </button>

      <!-- 番茄鐘與工具 -->
      <button onclick="toggleToolModal()" class="p-2.5 rounded-xl border border-white/70 dark:border-claude-darkBorder hover:border-claude-terracotta bg-white/80 dark:bg-claude-darkCard/80 hover:text-claude-terracotta transition-all text-sm flex items-center gap-1.5 shadow-sm backdrop-blur-md" title="小工具 · Tools">
        <i data-lucide="sparkles" class="w-4 h-4"></i>
      </button>

      <!-- 外觀主題切換 -->
      <button onclick="toggleTheme()" class="p-2.5 rounded-xl border border-white/70 dark:border-claude-darkBorder hover:border-claude-terracotta bg-white/80 dark:bg-claude-darkCard/80 transition-all text-claude-muted dark:text-claude-darkMuted shadow-sm backdrop-blur-md" title="切換外觀 · Theme">
        <i id="themeIcon" data-lucide="moon" class="w-4 h-4"></i>
      </button>
    </div>
  </header>

  <!-- 主內容區域 / Main Container -->
  <main class="relative z-10 w-full max-w-5xl mx-auto px-6 flex-1 flex flex-col pb-16">
    
    <!-- AI 打字機標題與中央搜尋區塊 / Dynamic AI Typing Omnibar -->
    <div class="my-6 md:my-10 text-center">
      
      <!-- AI 打字機標題 -->
      <div class="min-h-[2.75rem] flex items-center justify-center">
        <h2 id="aiHeading" class="font-serif text-3xl sm:text-4xl text-claude-text dark:text-claude-darkText font-normal italic tracking-tight inline-flex items-center">
          <span id="typedGreeting"></span>
          <span id="typingCursor" class="inline-block w-[2.5px] h-7 sm:h-8 bg-claude-terracotta ml-1 animate-pulse"></span>
        </h2>
      </div>

      <!-- Claude 經典液態磨砂搜尋框 / Liquid Omnibar -->
      <div class="mt-6 max-w-2xl mx-auto relative group">
        <div class="relative bg-white/75 dark:bg-claude-darkCard/80 backdrop-blur-xl rounded-2xl border border-white/80 dark:border-claude-darkBorder focus-within:border-claude-terracotta dark:focus-within:border-claude-terracotta shadow-[0_8px_30px_rgb(0,0,0,0.04)] dark:shadow-[0_8px_30px_rgb(0,0,0,0.4)] transition-all p-2 flex flex-col gap-2">
          
          <div class="flex items-center px-3 pt-1">
            <i data-lucide="search" class="w-5 h-5 text-claude-muted dark:text-claude-darkMuted mr-2.5"></i>
            <input 
              id="omniInput" 
              type="text" 
              placeholder="搜尋站點、社群或輸入關鍵字即時過濾... (按 Enter 搜尋)"
              class="w-full bg-transparent text-sm focus:outline-none placeholder-claude-muted/60 dark:placeholder-claude-darkMuted/60 text-claude-text dark:text-claude-darkText"
              oninput="handleLiveFilter()"
              onkeydown="handleSearchKey(event)"
            >
            <span class="text-[10px] px-1.5 py-0.5 rounded border border-claude-border/80 dark:border-claude-darkBorder text-claude-muted dark:text-claude-darkMuted font-mono">/</span>
          </div>

          <!-- 快速切換搜尋引擎 -->
          <div class="flex items-center justify-between pt-1 border-t border-claude-border/40 dark:border-claude-darkBorder/50 px-2 text-xs">
            <div class="flex items-center gap-1.5 overflow-x-auto py-1">
              <span class="text-[11px] text-claude-muted dark:text-claude-darkMuted mr-1">引擎:</span>
              <button onclick="setEngine('google')" class="engine-badge active px-2.5 py-0.5 rounded-full text-[11px] bg-claude-terracotta text-white font-medium">Google</button>
              <button onclick="setEngine('duckduckgo')" class="engine-badge px-2.5 py-0.5 rounded-full text-[11px] text-claude-muted hover:text-claude-text dark:text-claude-darkMuted">DuckDuckGo</button>
              <button onclick="setEngine('github')" class="engine-badge px-2.5 py-0.5 rounded-full text-[11px] text-claude-muted hover:text-claude-text dark:text-claude-darkMuted">GitHub</button>
              <button onclick="setEngine('academic')" class="engine-badge px-2.5 py-0.5 rounded-full text-[11px] text-claude-muted hover:text-claude-text dark:text-claude-darkMuted">Scholar</button>
            </div>
            <button onclick="clearSearch()" id="clearBtn" class="text-xs text-claude-muted hover:text-claude-terracotta hidden">清除</button>
          </div>
        </div>
      </div>
    </div>

