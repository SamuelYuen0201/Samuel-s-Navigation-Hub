  <!-- 邏輯腳本 / Core Scripts -->
  <script>
    // 初始化 Lucide 圖標
    lucide.createIcons();

    // =========================================================
    // 方案三 + 方案四融合引擎：
    // 1. 等高線地形波紋 (Marching Squares Topographic Flow - 方案四)
    // 2. 互動式向量磁場點陣與彈簧物理 (Magnetic Dot Matrix & Spring Physics - 方案三)
    // =========================================================
    const canvas = document.getElementById('liveFluidCanvas');
    const ctx = canvas.getContext('2d');
    let width = 0, height = 0, dpr = 1;

    // 固定種子偽隨機雜訊表 (Deterministic Value Noise Table)
    const PERM = new Uint8Array(512);
    (function initNoiseTable() {
      const p = new Uint8Array(256);
      for (let i = 0; i < 256; i++) p[i] = i;
      let seed = 20260408;
      for (let i = 255; i > 0; i--) {
        seed = (seed * 1664525 + 1013904223) >>> 0;
        const j = seed % (i + 1);
        const tmp = p[i]; p[i] = p[j]; p[j] = tmp;
      }
      for (let i = 0; i < 512; i++) PERM[i] = p[i & 255];
    })();

    function fade(t) { return t * t * t * (t * (t * 6 - 15) + 10); }
    function lerp(a, b, t) { return a + t * (b - a); }

    function grad2(hash, x, y) {
      const h = hash & 7;
      const u = h < 4 ? x : y;
      const v = h < 4 ? y : x;
      return ((h & 1) ? -u : u) + ((h & 2) ? -2.0 * v : 2.0 * v);
    }

    function perlin2D(x, y) {
      const X = Math.floor(x) & 255;
      const Y = Math.floor(y) & 255;
      x -= Math.floor(x);
      y -= Math.floor(y);
      const u = fade(x);
      const v = fade(y);
      const A = PERM[X] + Y;
      const B = PERM[X + 1] + Y;
      return lerp(
        lerp(grad2(PERM[A], x, y), grad2(PERM[B], x - 1, y), u),
        lerp(grad2(PERM[A + 1], x, y - 1), grad2(PERM[B + 1], x - 1, y - 1), u),
        v
      ) * 0.5 + 0.5;
    }

    // 雙八度平滑地貌噪聲函數 (回傳 0.0 ~ 1.0 海拔高度)
    function sampleElevation(x, y, t) {
      const scale1 = 0.0019;
      const scale2 = 0.0044;
      const n1 = perlin2D(x * scale1 + t * 0.14, y * scale1 - t * 0.10);
      const n2 = perlin2D(x * scale2 - t * 0.09 + 41.7, y * scale2 + t * 0.12 + 19.3);
      return n1 * 0.72 + n2 * 0.28;
    }

    // 互動磁場點陣與等高線網格配置
    let dotGrid = [];
    let topoCols = 0, topoRows = 0;
    let topoCellSize = 34;
    let fieldValues = new Float32Array(0);
    let magneticPulses = [];
    let pointer = {
      x: -9999, y: -9999,
      vx: 0, vy: 0,
      lastX: -9999, lastY: -9999,
      active: false
    };

    function initHybridBackground() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      // 1. 初始化方案三：整齊幾何向量磁場點陣 (Magnetic Dot Matrix)
      dotGrid = [];
      const spacing = width < 640 ? 34 : 30;
      const cols = Math.ceil(width / spacing) + 1;
      const rows = Math.ceil(height / spacing) + 1;
      const offsetX = (width - (cols - 1) * spacing) * 0.5;
      const offsetY = (height - (rows - 1) * spacing) * 0.5;

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const ox = offsetX + c * spacing;
          const oy = offsetY + r * spacing;
          dotGrid.push({
            ox, oy,
            x: ox, y: oy,
            vx: 0, vy: 0,
            energy: 0,
            angle: 0
          });
        }
      }

      // 2. 初始化方案四：Marching Squares 等高線取樣網格
      topoCellSize = width < 640 ? 38 : 32;
      topoCols = Math.ceil(width / topoCellSize) + 1;
      topoRows = Math.ceil(height / topoCellSize) + 1;
      fieldValues = new Float32Array(topoCols * topoRows);
    }

    window.addEventListener('resize', initHybridBackground);
    initHybridBackground();

    // 滑鼠與觸控磁場互動事件
    function updatePointer(clientX, clientY) {
      pointer.vx = clientX - (pointer.lastX === -9999 ? clientX : pointer.lastX);
      pointer.vy = clientY - (pointer.lastY === -9999 ? clientY : pointer.lastY);
      pointer.x = clientX;
      pointer.y = clientY;
      pointer.lastX = clientX;
      pointer.lastY = clientY;
      pointer.active = true;
    }

    function spawnMagneticPulse(x, y, maxRadius = 260, strength = 1.0) {
      magneticPulses.push({
        x, y,
        radius: 6,
        maxRadius,
        speed: 4.8,
        strength
      });
      if (magneticPulses.length > 8) magneticPulses.shift();
    }

    window.addEventListener('mousemove', (e) => updatePointer(e.clientX, e.clientY), { passive: true });
    window.addEventListener('touchmove', (e) => {
      if (e.touches && e.touches[0]) updatePointer(e.touches[0].clientX, e.touches[0].clientY);
    }, { passive: true });
    window.addEventListener('mousedown', (e) => spawnMagneticPulse(e.clientX, e.clientY, 270, 1.35), { passive: true });
    window.addEventListener('touchstart', (e) => {
      if (e.touches && e.touches[0]) {
        updatePointer(e.touches[0].clientX, e.touches[0].clientY);
        spawnMagneticPulse(e.touches[0].clientX, e.touches[0].clientY, 240, 1.2);
      }
    }, { passive: true });
    window.addEventListener('mouseleave', () => {
      pointer.active = false;
      pointer.x = -9999;
      pointer.y = -9999;
    });

    // Marching Squares 邊緣線性插值輔助函數
    function interpEdge(x1, y1, v1, x2, y2, v2, level) {
      const denom = v2 - v1;
      const mu = Math.abs(denom) < 0.00001 ? 0.5 : (level - v1) / denom;
      return [x1 + mu * (x2 - x1), y1 + mu * (y2 - y1)];
    }

    // 繪製特定海拔高度的等高線 (Marching Squares Isoline)
    function traceIsoline(level) {
      ctx.beginPath();
      for (let r = 0; r < topoRows - 1; r++) {
        const y0 = r * topoCellSize;
        const y1 = (r + 1) * topoCellSize;
        const rowOffset = r * topoCols;
        const nextRowOffset = (r + 1) * topoCols;

        for (let c = 0; c < topoCols - 1; c++) {
          const x0 = c * topoCellSize;
          const x1 = (c + 1) * topoCellSize;

          const vTL = fieldValues[rowOffset + c];
          const vTR = fieldValues[rowOffset + c + 1];
          const vBR = fieldValues[nextRowOffset + c + 1];
          const vBL = fieldValues[nextRowOffset + c];

          let mask = 0;
          if (vTL >= level) mask |= 8;
          if (vTR >= level) mask |= 4;
          if (vBR >= level) mask |= 2;
          if (vBL >= level) mask |= 1;
          if (mask === 0 || mask === 15) continue;

          // 四個邊界插值點：Top(0), Right(1), Bottom(2), Left(3)
          let pTop, pRight, pBottom, pLeft;
          if (mask & 8 ^ (mask & 4) << 1) pTop = interpEdge(x0, y0, vTL, x1, y0, vTR, level);
          if ((mask & 4) >> 2 ^ (mask & 2) >> 1) pRight = interpEdge(x1, y0, vTR, x1, y1, vBR, level);
          if ((mask & 2) >> 1 ^ (mask & 1)) pBottom = interpEdge(x0, y1, vBL, x1, y1, vBR, level);
          if ((mask & 8) >> 3 ^ (mask & 1)) pLeft = interpEdge(x0, y0, vTL, x0, y1, vBL, level);

          switch (mask) {
            case 1: case 14:
              ctx.moveTo(pLeft[0], pLeft[1]); ctx.lineTo(pBottom[0], pBottom[1]); break;
            case 2: case 13:
              ctx.moveTo(pBottom[0], pBottom[1]); ctx.lineTo(pRight[0], pRight[1]); break;
            case 3: case 12:
              ctx.moveTo(pLeft[0], pLeft[1]); ctx.lineTo(pRight[0], pRight[1]); break;
            case 4: case 11:
              ctx.moveTo(pTop[0], pTop[1]); ctx.lineTo(pRight[0], pRight[1]); break;
            case 5:
              ctx.moveTo(pLeft[0], pLeft[1]); ctx.lineTo(pTop[0], pTop[1]);
              ctx.moveTo(pBottom[0], pBottom[1]); ctx.lineTo(pRight[0], pRight[1]); break;
            case 6: case 9:
              ctx.moveTo(pTop[0], pTop[1]); ctx.lineTo(pBottom[0], pBottom[1]); break;
            case 7: case 8:
              ctx.moveTo(pLeft[0], pLeft[1]); ctx.lineTo(pTop[0], pTop[1]); break;
            case 10:
              ctx.moveTo(pLeft[0], pLeft[1]); ctx.lineTo(pBottom[0], pBottom[1]);
              ctx.moveTo(pTop[0], pTop[1]); ctx.lineTo(pRight[0], pRight[1]); break;
          }
        }
      }
      ctx.stroke();
    }

    // 等高線海拔閾值（含主等高線 Index Contour 與次等高線）
    const CONTOUR_LEVELS = [
      { val: 0.28, major: false },
      { val: 0.35, major: true },
      { val: 0.42, major: false },
      { val: 0.49, major: false },
      { val: 0.56, major: true },
      { val: 0.63, major: false },
      { val: 0.70, major: true }
    ];

    let animTime = 0;

    function renderHybridBackground() {
      ctx.clearRect(0, 0, width, height);
      const isDark = document.documentElement.classList.contains('dark');
      animTime += 0.0085;

      // ---------------------------------------------------------
      // A. 游標環境聚光燈 (Ambient Radial Cursor Glow)
      // ---------------------------------------------------------
      if (pointer.active) {
        const spotGrad = ctx.createRadialGradient(pointer.x, pointer.y, 0, pointer.x, pointer.y, 320);
        spotGrad.addColorStop(0, isDark ? 'rgba(217, 119, 87, 0.11)' : 'rgba(217, 119, 87, 0.09)');
        spotGrad.addColorStop(0.5, isDark ? 'rgba(230, 161, 92, 0.04)' : 'rgba(230, 161, 92, 0.04)');
        spotGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
        ctx.fillStyle = spotGrad;
        ctx.beginPath();
        ctx.arc(pointer.x, pointer.y, 320, 0, Math.PI * 2);
        ctx.fill();
      }

      // ---------------------------------------------------------
      // B. 方案四：計算並繪製演算法等高線地形波紋 (Topographic Contours)
      // ---------------------------------------------------------
      for (let r = 0; r < topoRows; r++) {
        const y = r * topoCellSize;
        const rowOffset = r * topoCols;
        for (let c = 0; c < topoCols; c++) {
          const x = c * topoCellSize;
          let elev = sampleElevation(x, y, animTime);

          // 游標磁場對地貌產生輕微隆起扭曲，令等高線與滑鼠產生互動
          if (pointer.active) {
            const dx = x - pointer.x;
            const dy = y - pointer.y;
            const distSq = dx * dx + dy * dy;
            if (distSq < 55000) {
              elev += Math.exp(-distSq / 18000) * 0.085;
            }
          }
          fieldValues[rowOffset + c] = elev;
        }
      }

      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';

      for (let i = 0; i < CONTOUR_LEVELS.length; i++) {
        const lv = CONTOUR_LEVELS[i];
        if (lv.major) {
          ctx.strokeStyle = isDark
            ? 'rgba(217, 119, 87, 0.17)'
            : 'rgba(217, 119, 87, 0.16)';
          ctx.lineWidth = 1.15;
        } else {
          ctx.strokeStyle = isDark
            ? 'rgba(237, 235, 232, 0.055)'
            : 'rgba(122, 117, 109, 0.075)';
          ctx.lineWidth = 0.75;
        }
        traceIsoline(lv.val);
      }

      // ---------------------------------------------------------
      // C. 更新點擊磁場脈衝波 (Magnetic Click Pulses)
      // ---------------------------------------------------------
      for (let i = magneticPulses.length - 1; i >= 0; i--) {
        const mp = magneticPulses[i];
        mp.radius += mp.speed;
        const progress = mp.radius / mp.maxRadius;
        if (progress >= 1) {
          magneticPulses.splice(i, 1);
          continue;
        }
        const ringAlpha = (1 - progress) * (isDark ? 0.28 : 0.22);
        ctx.beginPath();
        ctx.arc(mp.x, mp.y, mp.radius, 0, Math.PI * 2);
        ctx.strokeStyle = `rgba(217, 119, 87, ${ringAlpha})`;
        ctx.lineWidth = 1.1 * (1 - progress * 0.5);
        ctx.stroke();
      }

      // ---------------------------------------------------------
      // D. 方案三：互動式向量磁場點陣 (Magnetic Vector Field Dots)
      // ---------------------------------------------------------
      const magnetRadius = 165;
      const springStiffness = 0.075;
      const damping = 0.82;

      for (let i = 0; i < dotGrid.length; i++) {
        const d = dotGrid[i];

        // 1. 底層等高線流場微幅呼吸偏移 (令靜態點陣與等高線有機聯動)
        const localElev = sampleElevation(d.ox, d.oy, animTime);
        const flowAngle = localElev * Math.PI * 4;
        const targetX = d.ox + Math.cos(flowAngle) * 1.6;
        const targetY = d.oy + Math.sin(flowAngle) * 1.6;

        let interactEnergy = 0;

        // 2. 游標磁場排斥與切線渦流力 (Magnetic Dipole Repulsion & Swirl)
        if (pointer.active) {
          const dx = d.x - pointer.x;
          const dy = d.y - pointer.y;
          const dist = Math.hypot(dx, dy);

          if (dist < magnetRadius && dist > 0.01) {
            const factor = Math.pow(1 - dist / magnetRadius, 1.8);
            const radX = dx / dist;
            const radY = dy / dist;
            // 結合徑向推開與微弱切線旋渦感
            const pushForce = factor * 2.65;
            const swirlForce = factor * 0.45;
            d.vx += radX * pushForce - radY * swirlForce + pointer.vx * factor * 0.03;
            d.vy += radY * pushForce + radX * swirlForce + pointer.vy * factor * 0.03;
            interactEnergy = Math.max(interactEnergy, factor);
          }
        }

        // 3. 點擊脈衝波震盪牽引
        for (let p = 0; p < magneticPulses.length; p++) {
          const mp = magneticPulses[p];
          const dx = d.x - mp.x;
          const dy = d.y - mp.y;
          const dist = Math.hypot(dx, dy);
          const distFromWave = Math.abs(dist - mp.radius);
          const band = 32;
          if (distFromWave < band && dist > 0.01) {
            const waveFactor = (1 - distFromWave / band) * (1 - mp.radius / mp.maxRadius) * mp.strength;
            d.vx += (dx / dist) * waveFactor * 2.2;
            d.vy += (dy / dist) * waveFactor * 2.2;
            interactEnergy = Math.max(interactEnergy, waveFactor);
          }
        }

        // 4. 胡克定律彈簧歸位物理 (Hooke's Law Spring Return)
        d.vx += (targetX - d.x) * springStiffness;
        d.vy += (targetY - d.y) * springStiffness;
        d.vx *= damping;
        d.vy *= damping;
        d.x += d.vx;
        d.y += d.vy;

        // 計算點陣位移量與磁場能量
        const disp = Math.hypot(d.x - targetX, d.y - targetY);
        const targetEnergy = Math.min(1, interactEnergy + disp * 0.045);
        d.energy += (targetEnergy - d.energy) * 0.18;

        // 海拔高亮：當節點剛好位於主等高線附近時微微發亮
        const nearContour = (Math.abs(localElev - 0.35) < 0.018 || Math.abs(localElev - 0.56) < 0.018) ? 0.25 : 0;
        const totalHighlight = Math.min(1, d.energy + nearContour);

        // 當節點受磁場牽引時，由圓點漸變為指向磁場方向嘅精密向量短線 (Vector Field Tick)
        if (disp > 1.25) {
          d.angle = Math.atan2(d.y - d.oy, d.x - d.ox);
          const tickLen = Math.min(7.5, 1.5 + disp * 0.38);
          const cosA = Math.cos(d.angle) * tickLen;
          const sinA = Math.sin(d.angle) * tickLen;

          ctx.beginPath();
          ctx.moveTo(d.x - cosA * 0.6, d.y - sinA * 0.6);
          ctx.lineTo(d.x + cosA, d.y + sinA);
          ctx.strokeStyle = `rgba(217, 119, 87, ${0.28 + totalHighlight * 0.58})`;
          ctx.lineWidth = 1.45;
          ctx.stroke();
        } else {
          // 靜止或微動狀態：極簡幾何圓點
          const radius = 1.05 + totalHighlight * 0.85;
          ctx.beginPath();
          ctx.arc(d.x, d.y, radius, 0, Math.PI * 2);
          if (totalHighlight > 0.12) {
            ctx.fillStyle = `rgba(217, 119, 87, ${0.22 + totalHighlight * 0.55})`;
          } else {
            ctx.fillStyle = isDark
              ? 'rgba(237, 235, 232, 0.14)'
              : 'rgba(122, 117, 109, 0.18)';
          }
          ctx.fill();
        }
      }

      requestAnimationFrame(renderHybridBackground);
    }
    requestAnimationFrame(renderHybridBackground);

    // =========================================================
    // Immich 旅行珍貴媒體畫廊引擎 (Immich Shared Link Gallery)
    // =========================================================
    const IMMICH_BASE_URL = 'https://photo.samuelyuen.com';
    const IMMICH_SHARE_KEY = 'Ac7L4VgHBhpl5f0wbtm4xt7kiqzvjPAggAS4geDpaFuO3oJ1zOhzbUzkQn30vPI9NGE';
    const IMMICH_SHARE_PAGE_URL = `${IMMICH_BASE_URL}/share/${IMMICH_SHARE_KEY}`;

    let immichAssets = [];
    let currentAssetIndex = 0;
    let immichSlideTimer = null;
    let isImmichPlaying = true;
    let isIframeMode = false;

    function shuffleArray(arr) {
      const copy = [...arr];
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    }

    async function initImmichGallery() {
      const candidateEndpoints = [
        `${IMMICH_BASE_URL}/api/shared-links/me?key=${IMMICH_SHARE_KEY}`,
        `${IMMICH_BASE_URL}/api/shared-link/me?key=${IMMICH_SHARE_KEY}`
      ];

      let sharedData = null;
      for (const endpoint of candidateEndpoints) {
        try {
          const res = await fetch(endpoint, { mode: 'cors', credentials: 'omit' });
          if (res.ok) {
            sharedData = await res.json();
            break;
          }
        } catch (err) {}
      }

      if (sharedData) {
        if (sharedData.album && sharedData.album.albumName) {
          document.getElementById('immichAlbumBadge').innerText = sharedData.album.albumName;
        } else if (sharedData.description) {
          document.getElementById('immichAlbumBadge').innerText = sharedData.description;
        }

        let rawAssets = [];
        if (Array.isArray(sharedData.assets) && sharedData.assets.length > 0) {
          rawAssets = sharedData.assets;
        } else if (sharedData.album && Array.isArray(sharedData.album.assets) && sharedData.album.assets.length > 0) {
          rawAssets = sharedData.album.assets;
        }

        if (rawAssets.length === 0 && sharedData.album && sharedData.album.id) {
          try {
            const albumRes = await fetch(`${IMMICH_BASE_URL}/api/albums/${sharedData.album.id}?key=${IMMICH_SHARE_KEY}`, {
              mode: 'cors',
              credentials: 'omit'
            });
            if (albumRes.ok) {
              const albumData = await albumRes.json();
              if (Array.isArray(albumData.assets) && albumData.assets.length > 0) {
                rawAssets = albumData.assets;
              }
            }
          } catch (e) {}
        }

        if (rawAssets.length > 0) {
          immichAssets = shuffleArray(rawAssets);
          buildImmichThumbnailStrip();
          showImmichAsset(0);
          startImmichAutoPlay();
          return;
        }
      }

      switchGalleryToIframe(true);
    }

    function getImmichThumbUrl(assetId, size = 'preview') {
      return `${IMMICH_BASE_URL}/api/assets/${assetId}/thumbnail?size=${size}&key=${IMMICH_SHARE_KEY}`;
    }

    function getImmichOriginalUrl(assetId) {
      return `${IMMICH_BASE_URL}/api/assets/${assetId}/original?key=${IMMICH_SHARE_KEY}`;
    }

    function getImmichVideoUrl(assetId) {
      return `${IMMICH_BASE_URL}/api/assets/${assetId}/video/playback?key=${IMMICH_SHARE_KEY}`;
