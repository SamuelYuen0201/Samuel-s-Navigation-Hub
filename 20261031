        const gain = audioCtx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + duration);
      } catch(e){}
    }

    function playMatchSound() {
      playTone(523.25, 'triangle', 0.15);
      setTimeout(() => playTone(659.25, 'triangle', 0.15), 60);
      setTimeout(() => playTone(783.99, 'triangle', 0.25), 120);
    }

    function openGameModal() {
      document.getElementById('gameModal').classList.remove('hidden');
      if (gameCards.length === 0) {
        initGame();
      }
    }

    function closeGameModal() {
      document.getElementById('gameModal').classList.add('hidden');
    }

    function initGame() {
      score = 0;
      dockCards = [];
      historyStack = [];
      document.getElementById('gameScore').innerText = '0';
      document.getElementById('gameOverlay').classList.add('hidden');

      let pool = [];
      CARD_TYPES.forEach(t => {
        for (let i = 0; i < 6; i++) pool.push({ ...t });
      });
      pool.sort(() => Math.random() - 0.5);

      const positions = [
        ...genGrid(4, 4, 30, 20, 62, 66, 0),
        ...genGrid(3, 3, 61, 53, 62, 66, 1),
        ...genGrid(2, 3, 92, 53, 62, 66, 2),
        { x: 125, y: 120, layer: 3 },
        { x: 65,  y: 70,  layer: 3 },
        { x: 185, y: 70,  layer: 3 },
        { x: 65,  y: 170, layer: 3 },
        { x: 185, y: 170, layer: 3 }
      ];

      gameCards = pool.map((type, idx) => ({
        id: 'card_' + idx,
        type: type.id,
        icon: type.icon,
        label: type.label,
        color: type.color,
        x: positions[idx].x,
        y: positions[idx].y,
        layer: positions[idx].layer,
        status: 'board'
      }));

      renderBoard();
      renderDock();
    }

    function genGrid(rows, cols, startX, startY, stepX, stepY, layer) {
      let arr = [];
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          arr.push({ x: startX + c * stepX, y: startY + r * stepY, layer });
        }
      }
      return arr;
    }

    function renderBoard() {
      const board = document.getElementById('gameBoard');
      board.innerHTML = '';

      const activeOnBoard = gameCards.filter(c => c.status === 'board');
      document.getElementById('gameRemaining').innerText = activeOnBoard.length;

      activeOnBoard.forEach(c => {
        const isCovered = activeOnBoard.some(other => {
          if (other.layer <= c.layer || other.id === c.id) return false;
          return Math.abs(c.x - other.x) < (CARD_W - 6) && Math.abs(c.y - other.y) < (CARD_H - 8);
        });

        const cardEl = document.createElement('div');
        cardEl.className = `absolute w-[${CARD_W}px] h-[${CARD_H}px] rounded-xl border border-claude-border/80 dark:border-claude-darkBorder flex flex-col items-center justify-center select-none transition-all duration-150 ${c.color} ${isCovered ? 'game-card-covered' : 'game-card-active'}`;
        cardEl.style.width = `${CARD_W}px`;
        cardEl.style.height = `${CARD_H}px`;
        cardEl.style.left = `${c.x}px`;
        cardEl.style.top = `${c.y}px`;
        cardEl.style.zIndex = c.layer * 10;

        cardEl.innerHTML = `
          <i data-lucide="${c.icon}" class="w-5 h-5 mb-0.5"></i>
          <span class="text-[9px] font-medium leading-none">${c.label}</span>
        `;

        if (!isCovered) {
          cardEl.onclick = () => pickCard(c);
        }

        board.appendChild(cardEl);
      });

      lucide.createIcons();

      if (activeOnBoard.length === 0 && dockCards.length === 0) {
        showGameOver(true);
      }
    }

    function pickCard(card) {
      if (dockCards.length >= 7) return;

      playTone(440, 'sine', 0.08);
      historyStack.push({ cardId: card.id, prevStatus: card.status });

      card.status = 'dock';
      dockCards.push(card);
      dockCards.sort((a, b) => a.type.localeCompare(b.type));

      renderBoard();
      renderDock();
      checkElimination();
    }

    function renderDock() {
      const dock = document.getElementById('gameDock');
      dock.innerHTML = '';
      document.getElementById('slotCount').innerText = `${dockCards.length} / 7`;

      dockCards.forEach(c => {
        const item = document.createElement('div');
        item.className = `w-[42px] h-[52px] rounded-lg border border-claude-border dark:border-claude-darkBorder flex flex-col items-center justify-center ${c.color} shadow-sm shrink-0`;
        item.innerHTML = `
          <i data-lucide="${c.icon}" class="w-4 h-4 mb-0.5"></i>
          <span class="text-[8px] font-medium leading-none">${c.label}</span>
        `;
        dock.appendChild(item);
      });

      lucide.createIcons();
    }

    function checkElimination() {
      const counts = {};
      dockCards.forEach(c => {
        counts[c.type] = (counts[c.type] || 0) + 1;
      });

      let eliminated = false;
      for (const type in counts) {
        if (counts[type] >= 3) {
          playMatchSound();
          score += 100;
          document.getElementById('gameScore').innerText = score;

          let removed = 0;
          dockCards = dockCards.filter(c => {
            if (c.type === type && removed < 3) {
              c.status = 'cleared';
              removed++;
              return false;
            }
            return true;
          });
          eliminated = true;
          break;
        }
      }

      if (eliminated) {
        setTimeout(() => {
          renderDock();
          renderBoard();
        }, 120);
      } else if (dockCards.length >= 7) {
        setTimeout(() => showGameOver(false), 200);
      }
    }

    function undoGameMove() {
      if (historyStack.length === 0) return;
      const last = historyStack.pop();
      const card = gameCards.find(c => c.id === last.cardId);
      if (card && card.status === 'dock') {
        const idx = dockCards.findIndex(c => c.id === card.id);
        if (idx !== -1) {
          dockCards.splice(idx, 1);
          card.status = 'board';
          renderBoard();
          renderDock();
        }
      }
    }

    function showGameOver(isWin) {
      const overlay = document.getElementById('gameOverlay');
      const title = document.getElementById('gameOverlayTitle');
      const msg = document.getElementById('gameOverlayMsg');
      const icon = document.getElementById('gameOverlayIcon');

      overlay.classList.remove('hidden');
      if (isWin) {
        playTone(523, 'sine', 0.2);
        setTimeout(() => playTone(659, 'sine', 0.3), 100);
        title.innerText = '通關大吉！🎉';
        msg.innerText = `太強了！完美消除所有卡片，總分: ${score}`;
        icon.innerHTML = `<i data-lucide="trophy" class="w-6 h-6 text-amber-500"></i>`;
      } else {
        playTone(220, 'sawtooth', 0.3);
        title.innerText = '槽位已滿 😅';
        msg.innerText = '暫存槽已達 7 張上限，重開一局再接再厲！';
        icon.innerHTML = `<i data-lucide="alert-circle" class="w-6 h-6 text-rose-500"></i>`;
      }
      lucide.createIcons();
    }

    // 頁面載入時啟動
    window.addEventListener('DOMContentLoaded', () => {
      runAiTypewriter();
      initGpsWeather();
      initImmichGallery();

      const savedScratch = localStorage.getItem('claude_hub_scratch') || '';
      document.getElementById('scratchText').value = savedScratch;
      document.getElementById('scratchCount').innerText = `${savedScratch.length} 字元`;

      const savedTheme = localStorage.getItem('claude_hub_theme');
      if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
        updateThemeIcon(true);
      }
    });
  </script>
</body>
