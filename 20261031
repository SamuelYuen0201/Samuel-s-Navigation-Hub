    let cachedWeatherData = null;

    function interpretWeather(code) {
      if (code === 0) return { icon: 'sun', text: '晴朗' };
      if (code >= 1 && code <= 3) return { icon: 'cloud-sun', text: '多雲' };
      if (code >= 45 && code <= 48) return { icon: 'cloud-fog', text: '有霧' };
      if ((code >= 51 && code <= 67) || (code >= 80 && code <= 82)) return { icon: 'cloud-rain', text: '有雨' };
      if (code >= 95) return { icon: 'cloud-lightning', text: '雷暴' };
      return { icon: 'cloud', text: '陰天' };
    }

    async function fetchWeather(lat, lon) {
      try {
        const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,relative_humidity_2m,apparent_temperature,precipitation,weather_code,wind_speed_10m,surface_pressure&daily=temperature_2m_max,temperature_2m_min,uv_index_max&timezone=auto`;
        const res = await fetch(url);
        const data = await res.json();
        
        if (data && data.current) {
          cachedWeatherData = data;
          const temp = Math.round(data.current.temperature_2m);
          const wInfo = interpretWeather(data.current.weather_code);
          
          document.getElementById('weatherTemp').innerText = `${temp}°C`;
          document.getElementById('weatherCondition').innerText = wInfo.text;
          document.getElementById('weatherIconContainer').innerHTML = `<i data-lucide="${wInfo.icon}" class="w-3.5 h-3.5 text-amber-500"></i>`;
          lucide.createIcons();
        }
      } catch (e) {
        document.getElementById('weatherCondition').innerText = '天氣載入失敗';
      }
    }

