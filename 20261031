        mainVideo.pause();
        mainVideo.removeAttribute('src');
        mainVideo.classList.add('hidden');

        mainImg.style.opacity = '0.25';
        mainImg.classList.remove('hidden');
        mainImg.src = previewUrl;
        mainImg.onload = () => {
          mainImg.style.opacity = '1';
